# Angel One SmartAPI credentials — copy to .env and fill in.
#
# .env is gitignored. Never commit real values, and never paste them into
# config.yaml, an issue, or a chat window.
#
# Where each value comes from:
#   API_KEY      smartapi.angelbroking.com -> My Apps -> create a Trading API app
#   CLIENT_CODE  your Angel One login / client ID (e.g. A123456)
#   MPIN         the 4-digit MPIN you use to log in
#                (older API versions used the login password instead)
#   TOTP_SECRET  the base32 secret shown when you enable TOTP, e.g. when
#                scanning the QR into an authenticator app. This is the
#                SECRET STRING, not the 6-digit code it generates.
#
# The env_prefix in config.yaml selects which set of variables an account uses.

ANGEL_PRIMARY_API_KEY=
ANGEL_PRIMARY_CLIENT_CODE=
ANGEL_PRIMARY_MPIN=
ANGEL_PRIMARY_TOTP_SECRET=

# Second account — uncomment the matching block in config.yaml to use it.
# ANGEL_SECONDARY_API_KEY=
# ANGEL_SECONDARY_CLIENT_CODE=
# ANGEL_SECONDARY_MPIN=
# ANGEL_SECONDARY_TOTP_SECRET=
